# ============================================================
# DataBot AI — text2sql-agent Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ---------------------------
# Core Server
# ---------------------------
PORT=3000
NODE_ENV=development

# ---------------------------
# Database (Supabase / Neon / Postgres)
# ---------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------
# OpenAI
# ---------------------------
OPENAI_API_KEY=sk-...

# ---------------------------
# Slack Integration
# ---------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---------------------------
# Lemon Squeezy (Merchant of Record)
# Required for live billing and metered overages.
# Optional in development — billing calls will be skipped.
# ---------------------------
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=

# ---------------------------
# Security
# ---------------------------
# Must be a 32+ character string for AES-256-GCM encryption of DB passwords
ENCRYPTION_KEY=your_32_plus_character_secret_here

# ---------------------------
# Read-Only Database Proxy User
# ---------------------------
DB_READONLY_USER=databot_readonly
DB_READONLY_PASSWORD=databot_readonly_pass_secure_2026

# ---------------------------
# Frontend (Vercel)
# ---------------------------
FRONTEND_URL=https://your-app.vercel.app

# ---------------------------
# Frontend Environment Variables (set in Vercel project settings)
# ---------------------------
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
# NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/your-variant-id
