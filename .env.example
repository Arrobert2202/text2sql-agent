# Application
PORT=3000

# OpenAI (Used for RAG and Text-to-SQL)
OPENAI_API_KEY=

# Slack Application Credentials
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Database (PostgreSQL with pgvector)
DATABASE_URL=

# Stripe Billing Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Enterprise Encryption (AES-256-GCM for Tenant DB Credentials)
ENCRYPTION_KEY=

# Dedicated Read-Only DB Role
DB_READONLY_USER=databot_readonly
DB_READONLY_PASSWORD=
